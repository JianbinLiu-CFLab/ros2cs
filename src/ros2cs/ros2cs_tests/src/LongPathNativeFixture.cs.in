        internal const string Directory = @"@ROS2CS_LONG_PATH_NATIVE_FIXTURE_DIRECTORY@";
        internal const string ExtendedDirectory = @"\\?\@ROS2CS_LONG_PATH_NATIVE_FIXTURE_DIRECTORY@";
        internal const string LibraryStem = "@ROS2CS_LONG_PATH_NATIVE_FIXTURE_LIBRARY_STEM@";
        internal const string LibraryFileName = "@ROS2CS_LONG_PATH_NATIVE_FIXTURE_LIBRARY_STEM@.dll";
    }
}
