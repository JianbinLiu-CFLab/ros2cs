<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format2.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="2">
  <name>ros2cs_tests</name>
  <version>1.0.0</version>
  <description>Managed ros2cs NUnit tests plus a child-process finalizer crash probe.</description>
  <maintainer email="michal.drwiega@robotec.ai">Michal Drwiega</maintainer>
  <license>Apache License 2.0</license>

  <!-- Modifications Copyright (c) 2026 Jianbin Liu: expanded lifecycle, finalizer, graph, and native ABI coverage. -->

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>dotnet_cmake_module</buildtool_depend>

  <buildtool_export_depend>ament_cmake</buildtool_export_depend>

  <test_depend>ros2cs_common</test_depend>
  <test_depend>ros2cs_core</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>test_msgs</test_depend>
  <test_depend>example_interfaces</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
