# - Kept the local package fallback loader compatible with Python 3.12+.

import argparse
import importlib.util
import os
import sys


try:
    from rosidl_generator_cs import generate_cs
except ImportError:
    # modifying sys.path and importing the .NET package with the same
    # name as this script does not work on Windows. Use spec_from_file_location
    # and exec_module instead of the deprecated load_module API so Jazzy/Python
    # 3.12+ can still execute the fallback path.
    rosidl_generator_cs_root = os.path.dirname(os.path.dirname(__file__))
    rosidl_generator_cs_module = os.path.join(
        rosidl_generator_cs_root, 'rosidl_generator_cs', '__init__.py')
    if not os.path.exists(rosidl_generator_cs_module):
        raise
    spec = importlib.util.spec_from_file_location('rosidl_generator_cs', rosidl_generator_cs_module)
    if spec is None or spec.loader is None:
        raise ImportError('Unable to load rosidl_generator_cs from ' + rosidl_generator_cs_module)
    rosidl_generator_cs = importlib.util.module_from_spec(spec)
    sys.modules['rosidl_generator_cs'] = rosidl_generator_cs
    spec.loader.exec_module(rosidl_generator_cs)
    generate_cs = rosidl_generator_cs.generate_cs


def main(argv=sys.argv[1:]):
    parser = argparse.ArgumentParser(description='Generate the CSharp ROS interfaces.')
    parser.add_argument(
        '--generator-arguments-file',
        required=True,
        help='The location of the file containing the generator arguments')
    parser.add_argument(
        '--typesupport-impls',
        required=True,
        help='All the available typesupport implementations')
    parser.add_argument(
        '--cs-build-tool',
        required=True,
        help='CS build tool to be used for compiling. DotNetCore')
    args = parser.parse_args(argv)

    # CMake passes --typesupport-impls as a semicolon-separated CMake list.
    return generate_cs(args.generator_arguments_file, args.typesupport_impls.split(';'), args.cs_build_tool)


if __name__ == '__main__':
    sys.exit(main())
