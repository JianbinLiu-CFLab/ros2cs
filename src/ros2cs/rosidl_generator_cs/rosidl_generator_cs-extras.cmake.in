#
# configure_file template for the installed rosidl_generator_cs CMake extras.
# @PYTHON_INSTALL_DIR@ is substituted by CMake to the package's Python install
# directory. The ../../../ paths walk from the installed CMake package directory
# back to the install prefix, matching the ament package layout.
include("${CMAKE_CURRENT_LIST_DIR}/register_cs.cmake")
rosidl_generator_cs_extras(
  "${rosidl_generator_cs_DIR}/../../../lib/rosidl_generator_cs/rosidl_generator_cs"
  "${rosidl_generator_cs_DIR}/../../../@PYTHON_INSTALL_DIR@/rosidl_generator_cs/__init__.py;${rosidl_generator_cs_DIR}/../../../@PYTHON_INSTALL_DIR@/rosidl_generator_cs/generate_cs_impl.py;${rosidl_generator_cs_DIR}/../../../@PYTHON_INSTALL_DIR@/rosidl_generator_cs/clean_generate.py"
  "${rosidl_generator_cs_DIR}/../resource"
)
