# Modifications Copyright (c) 2026 Jianbin Liu.
#
# Modifications by Jianbin Liu:
# - Added legacy/unmaintained status header.
#
# Unmaintained on JianbinLiu-CFLab/main.
# This file tracks upstream Rolling/HEAD-style branches and is not verified for
# the active Jazzy maintenance line.
# It is retained as historical reference only and is likely incompatible with
# the current source without manual updates. In particular, it does not include
# example_interfaces and still uses the upstream RobotecAI dotnet_cmake_module
# 1.1.0 rather than the JianbinLiu-CFLab fork used by the active Jazzy line.

repositories:
  ros2/rosidl_defaults:
    type: git
    url: https://github.com/ros2/rosidl_defaults.git
    version: master
  ros2/common_interfaces:
    type: git
    url: https://github.com/ros2/common_interfaces.git
    version: master
  ros2/unique_identifier_msgs:
    type: git
    url: https://github.com/ros2/unique_identifier_msgs.git
    version: master
  ros2/rcl_interfaces:
    type: git
    url: https://github.com/ros2/rcl_interfaces.git
    version: master
  ros2/geometry2:
    type: git
    url: https://github.com/ros2/geometry2.git
    # geometry2 uses the upstream ros2 branch for Rolling.
    version: ros2
  ros2/test_interface_files:
    type: git
    url: https://github.com/ros2/test_interface_files.git
    version: master
  external/build_tools/dotnet_cmake_module:
    type: git
    url: https://github.com/RobotecAI/dotnet_cmake_module
    version: 1.1.0
  external/build_tools/ament_cmake_export_assemblies:
    type: git
    url: https://github.com/RobotecAI/ament_cmake_export_assemblies
    # Pinned to the commit verified by the active Jazzy maintenance line.
    version: 5a7411c1744d266717da9f292053165102b442c3
